# Copy this file to .env and adjust as needed.

# Hugging Face model name/path (the fine-tuned Qwen2.5-3B-Instruct adapter
# would be merged/loaded via this identifier in a real deployment)
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# "cpu" or "cuda"
DEVICE=cpu

# Generation settings
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1

# Path to the JSON schema used for output validation, relative to project root
SCHEMA_PATH=app/resume_schema.json
